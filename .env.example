# Browser-safe values from the target Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_GOOGLE_AUTH_ENABLED=false

# The same public values are required by SSR and server functions.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix this with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
DATABASE_URL=postgresql://REPLACE_ME

# Optional editorial endpoints. Keep disabled to guarantee no AI spend.
AI_DRAFTING_ENABLED=false
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional authenticated cron endpoints. Use a long random value in the host.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
